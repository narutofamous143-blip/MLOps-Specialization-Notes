Phase 5: Orchestration & Pipelines (Weeks 13-15)

Module 5.1: Apache Airflow
Theory: Airflow orchestrates complex workflows with dependencies, retries, scheduling, and monitoring. It's the industry standard for batch ML pipelines.

Practice + Code:

```python
# dags/ml_training_dag.py
from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.operators.bash import BashOperator
from datetime import datetime, timedelta
import sys
from pathlib import Path

# Add project to path
sys.path.append(str(Path(__file__).parent.parent / "src"))

default_args = {
    'owner': 'mlops',
    'depends_on_past': False,
    'email_on_failure': False,
    'email_on_retry': False,
    'retries': 1,
    'retry_delay': timedelta(minutes=5),
}

with DAG(
    'ml_training_pipeline',
    default_args=default_args,
    description='End-to-end ML training pipeline',
    schedule_interval=timedelta(days=1),  # Run daily
    start_date=datetime(2024, 1, 1),
    catchup=False,
    tags=['ml', 'training'],
) as dag:

    def validate_data_task():
        from data.validate import validate_data
        df = validate_data("data/processed/train.csv")
        return f"Validated {len(df)} rows"

    def train_model_task():
        from pipeline.train_with_mlflow import train_with_tracking
        run_id = train_with_tracking()
        return f"Training completed. Run ID: {run_id}"

    def check_metrics_task():
        import json
        with open("outputs/metrics.json") as f:
            metrics = json.load(f)
        if metrics['accuracy'] < 0.75:
            raise ValueError(f"Accuracy {metrics['accuracy']} below threshold")
        return "Metrics check passed"

    validate = PythonOperator(
        task_id='validate_data',
        python_callable=validate_data_task,
    )

    train = PythonOperator(
        task_id='train_model',
        python_callable=train_model_task,
    )

    check_metrics = PythonOperator(
        task_id='check_metrics',
        python_callable=check_metrics_task,
    )

    notify = BashOperator(
        task_id='notify_success',
        bash_command='echo "Pipeline completed successfully at $(date)"',
    )

    # Dependencies
    validate >> train >> check_metrics >> notify
```


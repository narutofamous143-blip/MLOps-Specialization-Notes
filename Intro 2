Module 4.2: Model Testing Strategy
Theory: ML testing = traditional tests + ML-specific tests. You need unit tests for code, data tests for quality, and model tests for behavior.

Practice + Code:

```python
# tests/test_model.py
import pytest
import joblib
import numpy as np
from pathlib import Path

MODEL_PATH = Path("outputs/model.pkl")

@pytest.fixture
def model():
    if not MODEL_PATH.exists():
        pytest.skip("Model not trained yet")
    return joblib.load(MODEL_PATH)

def test_model_file_exists():
    assert MODEL_PATH.exists(), "Trained model artifact missing"

def test_model_prediction_shape(model):
    # Test with dummy input
    X = np.random.rand(10, 4)  # 10 samples, 4 features
    preds = model.predict(X)
    assert len(preds) == 10
    assert all(isinstance(p, (int, np.integer)) for p in preds)

def test_model_probability_range(model):
    X = np.random.rand(5, 4)
    proba = model.predict_proba(X)
    assert proba.shape == (5, 2)  # Binary classification
    assert np.all(proba >= 0) and np.all(proba <= 1)
    assert np.allclose(proba.sum(axis=1), 1.0)

def test_model_robustness(model):
    # Model should not crash on edge cases
    X_zeros = np.zeros((1, 4))
    X_ones = np.ones((1, 4)) * 1000
    model.predict(X_zeros)
    model.predict(X_ones)  # Should not raise

# tests/test_data.py
import pandas as pd
import pytest
from src.data.validate import schema

def test_no_missing_target():
    df = pd.read_csv("data/processed/train.csv")
    assert df['target'].notna().all(), "Target column has missing values"

def test_feature_ranges():
    df = pd.read_csv("data/processed/train.csv")
    assert (df['feature_a'] > 0).all(), "feature_a must be positive"

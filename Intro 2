Phase 7: Monitoring & Observability (Weeks 19-21)

Module 7.1: Model Monitoring with Evidently AI
Theory: Models degrade in production. You must monitor: data drift, prediction drift, performance degradation, and business metrics.

Practice + Code:

```python
# src/monitoring/monitor.py
import pandas as pd
import numpy as np
from evidently import ColumnMapping
from evidently.report import Report
from evidently.metric_preset import DataDriftPreset, TargetDriftPreset, RegressionPreset
from pathlib import Path
import json
from datetime import datetime

def generate_monitoring_report(
    reference_path: str,
    current_path: str,
    output_dir: str = "monitoring_reports"
):
    """Generate drift report comparing reference vs current data."""
    
    reference = pd.read_csv(reference_path)
    current = pd.read_csv(current_path)
    
    # Column mapping
    column_mapping = ColumnMapping()
    column_mapping.target = 'target'
    column_mapping.prediction = 'prediction'
    
    # Build report
    report = Report(metrics=[
        DataDriftPreset(),
        TargetDriftPreset(),
    ])
    
    report.run(
        reference_data=reference,
        current_data=current,
        column_mapping=column_mapping
    )
    
    # Save HTML report
    Path(output_dir).mkdir(exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    report_path = f"{output_dir}/drift_report_{timestamp}.html"
    report.save_html(report_path)
    
    # Extract key metrics for alerting
    drift_metrics = {
        "timestamp": timestamp,
        "dataset_drift": report.as_dict()['metrics'][0]['result']['dataset_drift'],
        "number_of_drifted_columns": report.as_dict()['metrics'][0]['result']['number_of_drifted_columns'],
        "drift_share": report.as_dict()['metrics'][0]['result']['drift_share']
    }
    
    # Save metrics JSON
    metrics_path = f"{output_dir}/drift_metrics_{timestamp}.json"
    with open(metrics_path, "w") as f:
        json.dump(drift_metrics, f, indent=2)
    
    print(f"Report saved: {report_path}")
    print(f"Drift detected: {drift_metrics['dataset_drift']}")
    
    return drift_metrics

def check_drift_alert(metrics: dict, threshold: float = 0.5):
    """Trigger alert if drift exceeds threshold."""
    if metrics['drift_share'] > threshold:
        print(f"🚨 ALERT: Drift share {metrics['drift_share']:.2%} exceeds threshold {threshold:.2%}")
        # Here you would send Slack/email alert
        return True
    print(f"✅ Drift within acceptable range: {metrics['drift_share']:.2%}")
    return False

if __name__ == "__main__":
    metrics = generate_monitoring_report(
        reference_path="data/reference/reference_data.csv",
        current_path="data/current/production_data.csv"
    )
    check_drift_alert(metrics)
```


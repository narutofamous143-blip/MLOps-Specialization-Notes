Phase 1: Core ML Pipeline (Weeks 3-5)

Module 1.1: End-to-End ML Script (No MLOps Yet)
Theory: Before automating, you must build a solid manual pipeline. This is your baseline.

Practice + Code:

```python
# src/pipeline/train.py
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, f1_score, classification_report
import joblib
import json
from pathlib import Path
import yaml

def load_config(config_path="configs/train_config.yaml"):
    with open(config_path) as f:
        return yaml.safe_load(f)

def load_data(path):
    df = pd.read_csv(path)
    return df

def feature_engineering(df):
    # Example: create new features
    df['feature_ratio'] = df['feature_a'] / (df['feature_b'] + 1e-6)
    return df

def train_model(X_train, y_train, config):
    model = RandomForestClassifier(
        n_estimators=config['n_estimators'],
        max_depth=config['max_depth'],
        random_state=config['random_state']
    )
    model.fit(X_train, y_train)
    return model

def evaluate_model(model, X_test, y_test):
    preds = model.predict(X_test)
    metrics = {
        "accuracy": accuracy_score(y_test, preds),
        "f1_score": f1_score(y_test, preds, average='weighted')
    }
    print(classification_report(y_test, preds))
    return metrics

def save_artifacts(model, metrics, output_dir="outputs"):
    Path(output_dir).mkdir(exist_ok=True)
    
    # Save model
    joblib.dump(model, f"{output_dir}/model.pkl")
    
    # Save metrics
    with open(f"{output_dir}/metrics.json", "w") as f:
        json.dump(metrics, f, indent=2)
    
    print(f"Artifacts saved to {output_dir}")

def main():
    config = load_config()
    
    # Load
    df = load_data(config['data_path'])
    
    # Feature engineering
    df = feature_engineering(df)
    
    # Split
    X = df.drop(config['target_col'], axis=1)
    y = df[config['target_col']]
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=config['test_size'], random_state=config['random_state']
    )
    
    # Train
    model = train_model(X_train, y_train, config)
    
    # Evaluate
    metrics = evaluate_model(model, X_test, y_test)
    
    # Save
    save_artifacts(model, metrics)

if __name__ == "__main__":
    main()
```

Config file (`configs/train_config.yaml`):

```yaml
data_path: "data/processed/train.csv"
target_col: "target"
test_size: 0.2
random_state: 42
n_estimators: 100
max_depth: 10
```

What you learn: Structured code, config-driven development, artifact saving, separation of concerns.


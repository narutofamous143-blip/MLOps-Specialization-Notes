git add data/processed/train.csv.dvc
git commit -m "Add training data v1.1"

# View history
git log --oneline
dvc metrics show  # if you have metrics files tracked

# Push to remote storage
dvc remote add -d myremote s3://mybucket/dvcstore
dvc push

# Someone else pulls
git pull
dvc pull
```

Pipeline as Code (dvc.yaml):

```yaml
# dvc.yaml
stages:
  preprocess:
    cmd: python src/data/preprocess.py --input data/raw/raw.csv --output data/processed/train.csv
    deps:
      - src/data/preprocess.py
      - data/raw/raw.csv
    outs:
      - data/processed/train.csv
  
  train:
    cmd: python src/pipeline/train_with_mlflow.py
    deps:
      - src/pipeline/train_with_mlflow.py
      - data/processed/train.csv
      - configs/train_config.yaml
    outs:
      - outputs/metrics.json:
          cache: false
    metrics:
      - outputs/metrics.json:
          cache: false
```

Run pipeline:

```bash
dvc repro  # Runs only changed stages
```


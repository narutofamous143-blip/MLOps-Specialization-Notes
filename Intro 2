Module 1.2: Data Validation
Theory: Bad data silently kills models. You need schema validation, drift detection, and quality checks before training.

Practice + Code:

```python
# src/data/validate.py
import pandas as pd
import pandera as pa
from pandera import Column, Check, DataFrameSchema
from pathlib import Path

# Define expected schema
schema = DataFrameSchema({
    "feature_a": Column(float, Check.greater_than(0), nullable=False),
    "feature_b": Column(float, nullable=False),
    "feature_ratio": Column(float, nullable=True),
    "target": Column(int, Check.isin([0, 1]), nullable=False)
})

def validate_data(df: pd.DataFrame) -> pd.DataFrame:
    """Validate and return cleaned dataframe. Raises on failure."""
    try:
        validated = schema.validate(df)
        print(f"✅ Validation passed: {len(validated)} rows")
        return validated
    except pa.errors.SchemaError as e:
        print(f"❌ Validation failed:\n{e}")
        raise

def check_drift(reference_path: str, current_path: str, threshold: float = 0.1):
    """Simple statistical drift check using KS test."""
    from scipy import stats
    
    ref = pd.read_csv(reference_path)
    cur = pd.read_csv(current_path)
    
    drift_detected = False
    for col in ref.select_dtypes(include=[np.number]).columns:
        if col in cur.columns:
            stat, p_value = stats.ks_2samp(ref[col].dropna(), cur[col].dropna())
            if p_value < threshold:
                print(f"⚠️ Drift detected in {col}: p={p_value:.4f}")
                drift_detected = True
    
    if not drift_detected:
        print("✅ No significant drift detected")
    
    return drift_detected
```

What you learn: Schema validation, statistical testing, defensive programming.

